# v0.6 新增变量 —— 全部可选。把需要的行追加到现有 .env，不要覆盖原文件。
# 修改后运行：docker compose up -d --force-recreate app

# 多域名：列出的域名各自输出自己的 canonical / sitemap。默认已包含下面三个。
SITE_HOSTS=honeytime.life,www.honeytime.life,tarot.opsglobalonline.com
# 想把收录集中到一个主域名时填写（例如 honeytime.life）；留空则每个域名各自独立。
CANONICAL_HOST=
# 未知 Host 头时使用的回退地址
SITE_URL=https://tarot.opsglobalonline.com

# 访客每天可免注册获得的 AI 解读次数（按 IP 计），0 表示关闭免注册试抽
GUEST_AI_LIMIT=1

# 邮件（预约通知、找回密码）。不填则不发送邮件，其余功能照常。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
# 新预约提醒发给谁，多个用逗号分隔
NOTIFY_EMAIL=

# ---- v0.8 ----
# 强烈建议：把收录集中到主域名，避免 honeytime.life 和 tarot.opsglobalonline.com 被当成重复网站。
# 自动营销文案里的链接、每日一牌草稿也会使用这个域名。
# CANONICAL_HOST=honeytime.life
# 页面更新时是否通过 IndexNow 通知 Bing / Yandex（1 开启，0 关闭；后台也可单独关闭）
INDEXNOW=1

# ---- v0.8.1 自动发帖（小红书 / 微信视频号 / TikTok）----
# 发帖服务 publisher 默认随 docker compose 一起启动，下面全部可选。
# 1 = 无头浏览器（省资源，但更容易被平台识别）；默认 0 = 虚拟屏幕里的真实浏览器窗口
PUBLISHER_HEADLESS=0
# 触发平台验证/风控后，自动发帖暂停多少小时（期间到点改为邮件提醒手动发）
PUBLISHER_RISK_COOLDOWN_HOURS=24
# 服务器所在地区打不开某个平台时（例如中国大陆服务器访问 TikTok），为该平台单独指定代理
# 格式：http://user:pass@host:port 或 socks5://host:port
PUBLISHER_PROXY_TIKTOK=
PUBLISHER_PROXY_XIAOHONGSHU=
PUBLISHER_PROXY_CHANNELS=
