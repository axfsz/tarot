# v0.6 新增变量 —— 全部可选。把需要的行追加到现有 .env，不要覆盖原文件。
# 修改后运行：docker compose up -d --force-recreate app

# 多域名：列出的域名各自输出自己的 canonical / sitemap。默认已包含下面三个。
SITE_HOSTS=honeytime.life,www.honeytime.life,tarot.opsglobalonline.com
# 想把收录集中到一个主域名时填写（例如 honeytime.life）；留空则每个域名各自独立。
CANONICAL_HOST=
# 未知 Host 头时使用的回退地址
SITE_URL=https://tarot.opsglobalonline.com

# 访客每天可免注册获得的 AI 解读次数（按 IP 计），0 表示关闭免注册试抽
GUEST_AI_LIMIT=1

# 邮件（预约通知、找回密码）。不填则不发送邮件，其余功能照常。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
# 新预约提醒发给谁，多个用逗号分隔
NOTIFY_EMAIL=
